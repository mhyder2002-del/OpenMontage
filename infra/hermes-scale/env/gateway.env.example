# Hostinger VPS — Hermes public gateway (hermestudios.com)
# Copy values into the VPS / GitHub Actions env. Do not commit secrets.

PUBLIC_DOMAIN=hermestudios.com
HERMES_REQUIRE_AUTH=true
HERMES_API_KEY=

# Stripe test keys. Do not set sk_live without operator approval.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Backpressure at the door. Phase 1 (~50 in-flight) → 32–64.
# Phase 2 (450–550 in-flight) → 256–512, only after GPUs exist.
HERMES_MAX_INFLIGHT=32
HERMES_INFLIGHT_WAIT_SECONDS=5

# Production chat pool (NVIDIA vLLM or hosted API). Prefer this over LM Studio.
INFERENCE_BACKEND=vllm
INFERENCE_BASE_URL=http://GPU_NODE_PRIVATE_IP:8000/v1
INFERENCE_API_KEY=
INFERENCE_MODEL=qwen3-30b-a3b

# Studio fallback only. Leave unset in production once vLLM is up.
# LM_STUDIO_BASE_URL=https://lmstudio.hermestudios.com/v1
# LM_STUDIO_API_KEY=
# LM_STUDIO_MODEL=qwen/qwen3-coder-30b
