# Copy to .env on the VPS or pass via GitHub Actions. Do not commit secrets.
#
# Single local origin: http://127.0.0.1:8091  (/, /console, /api/*, /v1)
#   cd services/hermes-api
#   PUBLIC_DOMAIN=localhost HERMES_REQUIRE_AUTH=false \
#     uvicorn app:app --host 127.0.0.1 --port 8091
# Docker compose publishes the same app on the host as ${HERMES_HOST_PORT:-8091}:8080
# (container still listens on 8080; Caddy/VPS talk to that). Do not bind a second origin.
# Health and /livez stay 200 without LM Studio. Docker HEALTHCHECK uses /readyz
# (503 on locked domains until the API key env is set). /v1 returns 502 until you start
# LM Studio's OpenAI server or set INFERENCE_BASE_URL=http://127.0.0.1:1234/v1
# Mutating /api/campaigns, /api/flywheel/start|stop, /api/agents/tick require Bearer
# when PUBLIC_DOMAIN is production-locked. GET /health /console /api/campaigns stay public.
# Campaigns self-heal to a labeled dry-run orchestra when inference is down.
# Perpetual flywheel (self-check → campaign → enqueue next; max concurrent 1):
#   POST http://127.0.0.1:8091/api/flywheel/start
#   GET/POST http://127.0.0.1:8091/api/flywheel/stop
# Category agents: GET /api/agents  POST /api/agents/tick  GET /api/agents/{category}
HERMES_FLYWHEEL_SLEEP_SECONDS=0.25
HERMES_FLYWHEEL_AUTO=false
# Persist SQLite, flywheel, agents, billing under /app/data in Docker.
HERMES_FLYWHEEL_STORE=
HERMES_AGENTS_STORE=
HERMES_AGENT_CONCURRENCY=3
HERMES_AGENT_INFER_TIMEOUT=8
HERMES_CAMPAIGN_STORE=
# SQLite by default. Optional Postgres via DATABASE_URL (local only; do not buy hosted Postgres).
HERMES_DB_PATH=
DATABASE_URL=
HERMES_RESEARCH_TIMEOUT=4
HERMES_CAMPAIGN_RETRY_SECONDS=2
HERMES_CAMPAIGN_MAX_ATTEMPTS=3

PUBLIC_DOMAIN=hermestudios.com
HERMES_REQUIRE_AUTH=true
HERMES_API_KEY=
HERMES_MAX_INFLIGHT=32
HERMES_INFLIGHT_WAIT_SECONDS=5
# Host publish port for docker compose (maps to container 8080). Local story is 8091.
HERMES_HOST_PORT=8091

# Production chat pool (NVIDIA vLLM or hosted OpenAI-compatible /v1).
INFERENCE_BACKEND=vllm
INFERENCE_BASE_URL=
INFERENCE_API_KEY=
INFERENCE_MODEL=qwen3-30b-a3b

# Studio fallback only. Leave unset once vLLM is the public hot path.
LM_STUDIO_BASE_URL=
LM_STUDIO_API_KEY=
LM_STUDIO_MODEL=

# Optional Caddy Let's Encrypt contact (COMPOSE_PROFILES=tls).
CADDY_EMAIL=ops@hermestudios.com

# Stripe SDK is installed from requirements.billing.txt (requirements.txt is locked on this host).
# pip install -r requirements.txt -r requirements.billing.txt
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional Dashboard price IDs. If empty, Checkout uses inline price_data from catalog.
STRIPE_PRICE_CAMPAIGN_LAUNCH=
STRIPE_PRICE_CREDIT_PACK=
STRIPE_PRICE_AUTONOMOUS=
STRIPE_PRICE_INFERENCE_METER=
STRIPE_METER_EVENT_NAME=
STRIPE_AUTOMATIC_TAX=false
HERMES_BILLING_STORE=

# MoneyPrinterTurbo (optional topic→short). MIT: harry0703/MoneyPrinterTurbo
# Do not commit API keys. Default campaign stage is labeled DRY-RUN until enabled.
# Local: COMPOSE_PROFILES=moneyprinter docker compose up -d moneyprinter
MONEYPRINTER_ENABLED=false
MONEYPRINTER_BASE_URL=http://127.0.0.1:8088
MONEYPRINTER_API_KEY=
MONEYPRINTER_MODE=http
MONEYPRINTER_CLI=
MONEYPRINTER_WORKDIR=
MONEYPRINTER_LANGUAGE=en-US
MONEYPRINTER_HOST_PORT=8088
MONEYPRINTER_WEBUI_PORT=8501
MONEYPRINTER_TIMEOUT_SECONDS=12
MONEYPRINTER_POLL_SECONDS=0.5
MONEYPRINTER_POLL_ATTEMPTS=4
