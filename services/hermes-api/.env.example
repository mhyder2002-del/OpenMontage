# Copy to .env on the VPS or pass via GitHub Actions. Do not commit secrets.
#
# Local (no Docker):
#   cd services/hermes-api
#   PUBLIC_DOMAIN=localhost HERMES_REQUIRE_AUTH=false \
#     uvicorn app:app --host 127.0.0.1 --port 8080
# Health and /livez stay 200 without LM Studio. /v1 returns 502 until you start
# LM Studio's OpenAI server or set INFERENCE_BASE_URL=http://127.0.0.1:1234/v1

PUBLIC_DOMAIN=hermestudios.com
HERMES_REQUIRE_AUTH=true
HERMES_API_KEY=
HERMES_MAX_INFLIGHT=32
HERMES_INFLIGHT_WAIT_SECONDS=5
HERMES_HOST_PORT=8080

# Production chat pool (NVIDIA vLLM or hosted OpenAI-compatible /v1).
INFERENCE_BACKEND=vllm
INFERENCE_BASE_URL=
INFERENCE_API_KEY=
INFERENCE_MODEL=qwen3-30b-a3b

# Studio fallback only. Leave unset once vLLM is the public hot path.
LM_STUDIO_BASE_URL=
LM_STUDIO_API_KEY=
LM_STUDIO_MODEL=

# Optional Caddy Let's Encrypt contact (COMPOSE_PROFILES=tls).
CADDY_EMAIL=ops@hermestudios.com
